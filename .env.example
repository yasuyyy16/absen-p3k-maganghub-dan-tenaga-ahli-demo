# ==============================================================================
# Web Presensi P3K MagangHub & Tenaga Ahli - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (shared with Dashboard Kepegawaian).
# Required: YES (both development and production)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Session (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying user session JWT tokens (HS256).
# The application accepts either JWT_SECRET or SESSION_SECRET
# (evaluates process.env.SESSION_SECRET || process.env.JWT_SECRET).
# Required: YES in production (fatal error thrown if neither is configured).
# In development, a default fallback secret is used if left blank.
JWT_SECRET="replace-with-a-secure-random-secret-key"
SESSION_SECRET="replace-with-a-secure-random-secret-key"

# ------------------------------------------------------------------------------
# Cron Job Security
# ------------------------------------------------------------------------------
# Bearer secret token used to authenticate automated ALFA generation requests
# to /api/cron/alfa via Vercel Cron or external schedulers.
# Required: YES in production (endpoint rejects calls if missing or unmatched).
CRON_SECRET="replace-with-a-secure-random-cron-secret"

# ------------------------------------------------------------------------------
# Object Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Vercel Blob read/write token for storing attendance proof documents (Izin/Sakit).
# Required: YES in production (serverless deployment has ephemeral filesystem).
# In local development, leaving this empty will automatically fall back to saving
# files locally in the public/uploads/proofs/ directory.
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-read-write-token"

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
# Base URL of this Web Presensi application.
# Used when resolving full URLs for locally hosted proof attachments.
# Required: NO (Optional; defaults to relative paths)
APP_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# Geofence & Office Location (Optional Overrides)
# ------------------------------------------------------------------------------
# Coordinates and allowed radius (in meters) for geofenced attendance (Mon-Thu).
# Required: NO (Optional; if omitted, built-in defaults shown below are used)
# ABSENSI_OFFICE_LATITUDE="-6.1791728"
# ABSENSI_OFFICE_LONGITUDE="106.8350564"
# ABSENSI_OFFICE_RADIUS_METERS="100"

# ------------------------------------------------------------------------------
# Local Development & Testing Overrides (Development Only)
# ------------------------------------------------------------------------------
# These variables are strictly ignored in production (NODE_ENV === 'production').
# DEV_TIME_OVERRIDE="2026-09-07T08:00:00+07:00"
# TEST_AUTH_USER_ID="1"
